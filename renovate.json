{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"labels": [
		"dependencies"
	],
	"schedule": [
		"* * * * 1"
	],
	"enabledManagers": [
		"composer",
		"github-actions",
		"npm"
  ],
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true
	},
	"packageRules": [
		{
			"description": "Group minor updates for backend and frontend packages into single PR",
			"matchUpdateTypes": [
				"minor",
				"patch",
				"pin",
				"digest"
			],
			"minimumReleaseAge": "2 days",
			"groupName": "dependencies (minor)",
			"groupSlug": "minor-updates",
			"automerge": true
		},
		{
			"groupName": "Laravel packages",
			"groupSlug": "laravel",
			"matchPackageNames": [
				"laravel/**"
			]
		},
		{
			"groupName": "Pest packages",
			"groupSlug": "pest",
			"matchPackageNames": [
				"pestphp/**"
			]
		},
		{
			"description": "Use dedicated PRs for major updates",
			"minimumReleaseAge": "2 days",
			"matchUpdateTypes": [
				"major"
			],
			"groupName": null
		}
	]
}
